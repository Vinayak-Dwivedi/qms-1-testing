# Netlify demo environment — copy these into Netlify's "Environment variables"
# UI (Site settings → Environment variables). Do NOT commit real secrets.

# --- Required ---------------------------------------------------------------
# Neon (or any reachable) Postgres. Use the POOLED connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# 64-byte random secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
APP_SECRET=replace-with-a-real-64-byte-random-string

# Workspace login password for the demo.
APP_PASSWORD=demo-password

# Your deployed Netlify URL (set after the first deploy gives you a name).
APP_BASE_URL=https://your-site.netlify.app

# --- Demo-friendly defaults (optional) --------------------------------------
AUDIO_STORAGE_PROVIDER=local
MOCK_STT=true
SHOW_MOCK_ACTIONS=true
