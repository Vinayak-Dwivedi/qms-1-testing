// Quality Management System — Prisma schema
// Multi-tenant by client_id. No dialer tables yet; AI audit tables exist
// so the service can populate them later without further migrations.

generator client {
  provider = "prisma-client-js"
  // "native" covers local dev; "rhel-openssl-3.0.x" is the engine Netlify
  // Functions need at runtime (they run on AWS Lambda / Amazon Linux).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum CallDirection {
  INBOUND
  OUTBOUND
  INTERNAL
  UNKNOWN
}

enum CallStatus {
  COMPLETED
  MISSED
  FAILED
  DROPPED
  TRANSFERRED
  UNKNOWN
}

enum ScoringType {
  BINARY
}

enum TranscriptSource {
  AI
  HUMAN
  IMPORTED
}

enum SpeakerRole {
  AGENT
  CUSTOMER
  SYSTEM
  UNKNOWN
}

enum AuditStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ReviewStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum InsightType {
  COACHING
  RISK
  COMPLIANCE
  OPPORTUNITY
  SENTIMENT
}

enum InsightSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CallEventType {
  CALL_IMPORTED
  TRANSCRIPT_READY
  AUDIT_QUEUED
  AUDIT_STARTED
  AUDIT_COMPLETED
  AUDIT_FAILED
  MANUAL_REVIEW_STARTED
  MANUAL_REVIEW_COMPLETED
  NOTE_ADDED
  COMPLIANCE_ISSUE
  CUSTOMER_OBJECTION
  ESCALATION_RISK
  EMPATHY_GAP
  SCRIPT_DEVIATION
  POSSIBLE_RAISED_TONE
  RUDE_LANGUAGE
  INTERRUPTION
  POSITIVE_MOMENT
  OTHER
}

enum EventSpeaker {
  AGENT
  CUSTOMER
  BOTH
  UNKNOWN
}

enum EventSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ParameterResult {
  PASS
  FAIL
  NOT_FOUND
}

enum UserRole {
  OWNER
  AUDITOR
  AGENT
  VIEWER
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

// Daily-metered quotas. Add more kinds as we learn what to bill on.
enum QuotaKind {
  AUDITS_PER_DAY
  CALLS_PER_DAY
  STT_MINUTES_PER_DAY
}

// ---------- Tenancy ----------

model Client {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  industry     String?
  contactEmail String?  @map("contact_email")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  accesses     ClientAccess[]
  users        User[]
  apiKeys      ApiKey[]
  webhooks     Webhook[]
  quotas       ClientQuota[]
  quotaUsage   QuotaUsage[]
  campaigns    Campaign[]
  teams        Team[]
  agents       Agent[]
  parameters   ClientParameter[]
  calls        Call[]
  auditPrompts ClientAuditPrompt[]
  auditLogs    AuditLog[]

  @@map("clients")
}

// Outbound webhook subscription. `events` is a JSON array of event name strings
// (e.g. ["call.audit.completed", "call.transcript.ready"]). `secret` is the
// HMAC-SHA256 key included in the X-QMS-Signature header on delivery; stored
// in plaintext because HMAC needs the raw value at sign time.
model Webhook {
  id              String   @id @default(cuid())
  clientId        String   @map("client_id")
  label           String
  url             String
  events          Json
  secret          String
  isActive        Boolean  @default(true) @map("is_active")
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  client     Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([clientId])
  @@index([clientId, isActive])
  @@map("webhooks")
}

// Append-only attempt log for outbound webhook deliveries. Used for debugging
// failed integrations and as audit trail. One row per attempt; the worker
// updates `status` + `responseStatus` once the HTTP call returns.
model WebhookDelivery {
  id                  String                @id @default(cuid())
  webhookId           String                @map("webhook_id")
  eventType           String                @map("event_type")
  payload             Json
  attempt             Int                   @default(1)
  status              WebhookDeliveryStatus @default(PENDING)
  responseStatus      Int?                  @map("response_status")
  responseBodyExcerpt String?               @map("response_body_excerpt")
  error               String?
  deliveredAt         DateTime?             @map("delivered_at")
  createdAt           DateTime              @default(now()) @map("created_at")

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

// Optional per-client daily quota. Absent row = unlimited.
//
// Soft (hardEnforce=false, default): exceeding logs a warning + fires the
// quota.exceeded webhook; the request still succeeds.
//
// Hard (hardEnforce=true): exceeding throws QuotaExceededError, the calling
// route returns 429 with Retry-After, and the metered work is NOT done (so
// the tenant isn't billed for a rejected operation). Flip per kind once
// you have baseline usage data for that kind.
model ClientQuota {
  id          String    @id @default(cuid())
  clientId    String    @map("client_id")
  kind        QuotaKind
  dailyLimit  Int       @map("daily_limit")
  isActive    Boolean   @default(true) @map("is_active")
  hardEnforce Boolean   @default(false) @map("hard_enforce")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, kind])
  @@map("client_quotas")
}

// Per-day usage tally. `day` is the YYYY-MM-DD UTC date as a DATE column.
// `cost` is reserved for future cost-of-goods tracking (e.g. STT minutes
// times provider rate). One row per (clientId, kind, day).
model QuotaUsage {
  id        String    @id @default(cuid())
  clientId  String    @map("client_id")
  kind      QuotaKind
  day       DateTime  @db.Date
  count     Int       @default(0)
  cost      Float?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, kind, day])
  @@index([clientId, day])
  @@map("quota_usage")
}

// Long-lived API key for /api/v1/* access. The plaintext key is shown to the
// caller exactly once at creation; only the bcrypt hash is stored. The
// `prefix` is the unhashed lookup token (8 chars after qms_live_) so we can
// fetch the row in a single indexed query before bcrypt-comparing the rest.
// `scopes` is a JSON array of strings like ["calls:read", "calls:write"].
model ApiKey {
  id              String    @id @default(cuid())
  clientId        String    @map("client_id")
  label           String
  prefix          String    @unique
  hashedSecret    String    @map("hashed_secret")
  scopes          Json
  expiresAt       DateTime? @map("expires_at")
  lastUsedAt      DateTime? @map("last_used_at")
  isActive        Boolean   @default(true) @map("is_active")
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([clientId, isActive])
  @@map("api_keys")
}

// Per-user identity. Replaces ClientAccess long-term; both coexist during the
// hybrid-auth window. A user belongs to exactly one client (multi-tenant
// isolation). Email is unique within a client.
model User {
  id           String    @id @default(cuid())
  clientId     String    @map("client_id")
  email        String
  passwordHash String    @map("password_hash")
  name         String?
  role         UserRole  @default(VIEWER)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@unique([clientId, email])
  @@index([clientId])
  @@index([clientId, isActive])
  @@map("users")
}

// Append-only record of meaningful actions for compliance and forensics.
// Either actorUserId or actorClientAccessId is set (legacy login uses the
// latter). ipAddress + userAgent are best-effort.
model AuditLog {
  id                  String   @id @default(cuid())
  clientId            String   @map("client_id")
  actorUserId         String?  @map("actor_user_id")
  actorClientAccessId String?  @map("actor_client_access_id")
  action              String
  entity              String?
  entityId            String?  @map("entity_id")
  diff                Json?
  ipAddress           String?  @map("ip_address")
  userAgent           String?  @map("user_agent")
  createdAt           DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([actorUserId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// Editable, per-client audit prompt template. Only one row should have
// isActive=true per client at a time. Versioned so future edits can be tracked.
model ClientAuditPrompt {
  id         String   @id @default(cuid())
  clientId   String   @map("client_id")
  promptName String   @default("Default audit prompt") @map("prompt_name")
  promptText String   @map("prompt_text")
  isActive   Boolean  @default(true) @map("is_active")
  versionNo  Int      @default(1) @map("version_no")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([clientId, isActive])
  @@map("client_audit_prompts")
}

// Simple password-based access. One row per shared credential.
// No user accounts yet — `label` lets you identify which credential is in use.
model ClientAccess {
  id           String    @id @default(cuid())
  clientId     String    @map("client_id")
  label        String
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastUsedAt   DateTime? @map("last_used_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_access")
}

model Campaign {
  id          String    @id @default(cuid())
  clientId    String    @map("client_id")
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  startedOn   DateTime? @map("started_on")
  endedOn     DateTime? @map("ended_on")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  client Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  calls  Call[]
  agents Agent[]

  @@index([clientId])
  @@map("campaigns")
}

model Team {
  id          String   @id @default(cuid())
  clientId    String   @map("client_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  client Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agents Agent[]
  calls  Call[]

  @@index([clientId])
  @@map("teams")
}

model Agent {
  id           String    @id @default(cuid())
  clientId     String    @map("client_id")
  teamId       String?   @map("team_id")
  campaignId   String?   @map("campaign_id")
  name         String
  employeeCode String?   @map("employee_code")
  email        String?
  isActive     Boolean   @default(true) @map("is_active")
  hiredOn      DateTime? @map("hired_on")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  team     Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  calls    Call[]

  @@index([clientId])
  @@index([teamId])
  @@index([campaignId])
  @@map("agents")
}

// ---------- Parameters ----------
// Each client owns its parameters. No groups/templates by design.
// Scoring is binary: full max_score if AI determines parameter is fulfilled, else 0.
// A client/sub-parameter optionally maps to one StandardAuditParameter
// so 10 standard KPI cards can roll up the 24 sub-parameter scores.

model StandardAuditParameter {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  clientParameters ClientParameter[]

  @@map("standard_audit_parameters")
}

model ClientParameter {
  id                   String      @id @default(cuid())
  clientId             String      @map("client_id")
  parameterCategory    String      @map("parameter_category")
  parameterName        String      @map("parameter_name")
  parameterDescription String      @map("parameter_description")
  maxScore             Int         @map("max_score")
  aiInstruction        String      @map("ai_instruction")
  scoringType          ScoringType @default(BINARY) @map("scoring_type")
  displayOrder         Int         @default(0) @map("display_order")
  isActive             Boolean     @default(true) @map("is_active")
  standardParameterId  String?     @map("standard_parameter_id")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  client            Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  standardParameter StandardAuditParameter? @relation(fields: [standardParameterId], references: [id], onDelete: SetNull)
  aiParameterScores AiParameterScore[]

  @@index([clientId])
  @@index([clientId, displayOrder])
  @@index([standardParameterId])
  @@map("client_parameters")
}

// ---------- Calls ----------

model Call {
  id                   String        @id @default(cuid())
  clientId             String        @map("client_id")
  campaignId           String?       @map("campaign_id")
  agentId              String?       @map("agent_id")
  teamId               String?       @map("team_id")
  externalCallId       String?       @map("external_call_id")
  callerNumber         String?       @map("caller_number")
  calleeNumber         String?       @map("callee_number")
  customerName         String?       @map("customer_name")
  direction            CallDirection @default(UNKNOWN)
  callStartedAt        DateTime?     @map("call_started_at")
  callEndedAt          DateTime?     @map("call_ended_at")
  durationSeconds      Int?          @map("duration_seconds")
  firstResponseSeconds Int?          @map("first_response_seconds")
  averageHandleSeconds Int?          @map("average_handle_seconds")
  recordingUrl         String?       @map("recording_url")
  originalFileName     String?       @map("original_file_name")
  storedFileName       String?       @map("stored_file_name")
  audioPath            String?       @map("audio_path")
  mimeType             String?       @map("mime_type")
  fileSizeBytes        BigInt?       @map("file_size_bytes")
  language             String?
  status               CallStatus    @default(UNKNOWN)
  disposition          String?
  sentiment            String?
  aiScore              Float?        @map("ai_score")
  manualScore          Float?        @map("manual_score")
  finalScore           Float?        @map("final_score")
  manualDisposition    String?       @map("manual_disposition")
  processingStatus     String?       @map("processing_status")
  processingStartedAt  DateTime?     @map("processing_started_at")
  processingError      String?       @map("processing_error")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  client             Client                        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaign           Campaign?                     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  agent              Agent?                        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  team               Team?                         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  transcript         CallTranscript?
  aiAudits           AiAudit[]
  events             CallEvent[]
  insights           AiInsight[]
  manualReviews      ManualReview[]
  notes              CallNote[]
  segmentCorrections TranscriptSegmentCorrection[]

  @@unique([clientId, externalCallId])
  @@index([clientId])
  @@index([campaignId])
  @@index([agentId])
  @@index([teamId])
  @@index([callStartedAt])
  @@map("calls")
}

model CallTranscript {
  id                     String           @id @default(cuid())
  callId                 String           @unique @map("call_id")
  source                 TranscriptSource @default(AI)
  language               String?
  modelUsed              String?          @map("model_used")
  fallbackUsed           Boolean          @default(false) @map("fallback_used")
  fallbackReason         String?          @map("fallback_reason")
  attemptedModels        Json?            @map("attempted_models")
  qualityFlags           Json?            @map("quality_flags")
  speakerLabelsCorrected Boolean          @default(false) @map("speaker_labels_corrected")
  speakerCorrectionNote  String?          @map("speaker_correction_note")
  speakerCorrectedAt     DateTime?        @map("speaker_corrected_at")
  fullText               String           @map("full_text")
  generatedAt            DateTime?        @map("generated_at")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  call               Call                          @relation(fields: [callId], references: [id], onDelete: Cascade)
  segments           TranscriptSegment[]
  segmentCorrections TranscriptSegmentCorrection[]

  @@map("call_transcripts")
}

model TranscriptSegment {
  id              String      @id @default(cuid())
  transcriptId    String      @map("transcript_id")
  sequence        Int
  speaker         SpeakerRole @default(UNKNOWN)
  startMs         Int         @map("start_ms")
  endMs           Int         @map("end_ms")
  text            String
  confidenceScore Float?      @map("confidence_score")
  channel         String?
  speakerSource   String?     @map("speaker_source")
  createdAt       DateTime    @default(now()) @map("created_at")

  transcript  CallTranscript                @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  corrections TranscriptSegmentCorrection[]

  @@index([transcriptId, sequence])
  @@map("transcript_segments")
}

model TranscriptSegmentCorrection {
  id                  String      @id @default(cuid())
  transcriptSegmentId String      @map("transcript_segment_id")
  callId              String      @map("call_id")
  callTranscriptId    String      @map("call_transcript_id")
  oldSpeaker          SpeakerRole @map("old_speaker")
  newSpeaker          SpeakerRole @map("new_speaker")
  oldSpeakerSource    String?     @map("old_speaker_source")
  newSpeakerSource    String      @map("new_speaker_source")
  segmentText         String      @map("segment_text")
  startTimeSeconds    Float       @map("start_time_seconds")
  endTimeSeconds      Float       @map("end_time_seconds")
  rawSpeakerId        String?     @map("raw_speaker_id")
  correctedAt         DateTime    @default(now()) @map("corrected_at")
  correctedBy         String?     @map("corrected_by")
  correctionReason    String?     @map("correction_reason")

  transcriptSegment TranscriptSegment @relation(fields: [transcriptSegmentId], references: [id], onDelete: Cascade)
  call              Call              @relation(fields: [callId], references: [id], onDelete: Cascade)
  callTranscript    CallTranscript    @relation(fields: [callTranscriptId], references: [id], onDelete: Cascade)

  @@index([transcriptSegmentId])
  @@index([callId, correctedAt])
  @@index([callTranscriptId])
  @@map("transcript_segment_corrections")
}

// ---------- AI audit ----------

model AiAudit {
  id                     String      @id @default(cuid())
  callId                 String      @map("call_id")
  modelUsed              String?     @map("model_used")
  promptVersion          String?     @map("prompt_version")
  auditMode              String?     @map("audit_mode")
  auditRunNo             Int         @default(1) @map("audit_run_no")
  isLatest               Boolean     @default(true) @map("is_latest")
  status                 AuditStatus @default(PENDING)
  overallScore           Float?      @map("overall_score")
  maxPossibleScore       Float?      @map("max_possible_score")
  scorePercent           Float?      @map("score_percent")
  summary                String?
  sentiment              String?
  agentTone              String?     @map("agent_tone")
  customerEmotion        String?     @map("customer_emotion")
  hasComplianceIssue     Boolean?    @map("has_compliance_issue")
  complianceSeverity     String?     @map("compliance_severity")
  improvementArea        String?     @map("improvement_area")
  coachingRecommendation String?     @map("coaching_recommendation")
  nextBestAction         String?     @map("next_best_action")
  agentStrengths         Json?       @map("agent_strengths")
  agentWeaknesses        Json?       @map("agent_weaknesses")
  customerObjections     Json?       @map("customer_objections")
  complianceIssues       Json?       @map("compliance_issues")
  promptText             String?     @map("prompt_text")
  rawAiResponse          Json?       @map("raw_ai_response")
  validatedResponse      Json?       @map("validated_response")
  errorMessage           String?     @map("error_message")
  startedAt              DateTime?   @map("started_at")
  completedAt            DateTime?   @map("completed_at")
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")

  call            Call               @relation(fields: [callId], references: [id], onDelete: Cascade)
  parameterScores AiParameterScore[]

  @@index([callId])
  @@index([callId, isLatest])
  @@index([status])
  @@map("ai_audits")
}

model AiParameterScore {
  id                   String          @id @default(cuid())
  aiAuditId            String          @map("ai_audit_id")
  parameterId          String          @map("parameter_id")
  result               ParameterResult @default(NOT_FOUND)
  score                Int
  maxScore             Int             @map("max_score")
  isPassed             Boolean         @map("is_passed")
  reasoning            String?
  evidenceText         String?         @map("evidence_text")
  evidenceStartSeconds Float?          @map("evidence_start_seconds")
  evidenceEndSeconds   Float?          @map("evidence_end_seconds")
  confidenceScore      Float?          @map("confidence_score")
  createdAt            DateTime        @default(now()) @map("created_at")

  aiAudit   AiAudit         @relation(fields: [aiAuditId], references: [id], onDelete: Cascade)
  parameter ClientParameter @relation(fields: [parameterId], references: [id], onDelete: Restrict)

  @@unique([aiAuditId, parameterId])
  @@index([aiAuditId])
  @@index([parameterId])
  @@map("ai_parameter_scores")
}

model CallEvent {
  id               String         @id @default(cuid())
  callId           String         @map("call_id")
  aiAuditId        String?        @map("ai_audit_id")
  eventType        CallEventType  @map("event_type")
  speaker          EventSpeaker?
  startTimeSeconds Float?         @map("start_time_seconds")
  endTimeSeconds   Float?         @map("end_time_seconds")
  title            String?
  description      String?
  evidenceText     String?        @map("evidence_text")
  severity         EventSeverity?
  confidenceScore  Float?         @map("confidence_score")
  payload          Json?
  occurredAt       DateTime       @default(now()) @map("occurred_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, occurredAt])
  @@index([aiAuditId])
  @@map("call_events")
}

model AiInsight {
  id          String          @id @default(cuid())
  callId      String          @map("call_id")
  insightType InsightType     @map("insight_type")
  severity    InsightSeverity @default(LOW)
  title       String
  body        String
  createdAt   DateTime        @default(now()) @map("created_at")

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@map("ai_insights")
}

// ---------- Manual review ----------

model ManualReview {
  id           String       @id @default(cuid())
  callId       String       @map("call_id")
  reviewerName String       @map("reviewer_name")
  status       ReviewStatus @default(PENDING)
  score        Float?
  maxScore     Float?       @map("max_score")
  scorePercent Float?       @map("score_percent")
  notes        String?
  startedAt    DateTime?    @map("started_at")
  completedAt  DateTime?    @map("completed_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([status])
  @@map("manual_reviews")
}

model CallNote {
  id         String   @id @default(cuid())
  callId     String   @map("call_id")
  authorName String   @map("author_name")
  body       String
  isPinned   Boolean  @default(false) @map("is_pinned")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@map("call_notes")
}
